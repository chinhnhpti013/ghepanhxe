# Biến môi trường (chứa API key)
.env

# Ảnh tạm và PDF kết xuất
output/
renamed/

# Ảnh hồ sơ khách hàng (số khung, tem đăng kiểm, báo giá...) — KHÔNG đẩy lên GitHub
input/

# Python cache
__pycache__/
*.pyc
*.pyo

# Editor
.vscode/
*.swp

# Windows
Thumbs.db
desktop.ini

# Tài liệu nội bộ của Phòng (.docx/.xlsx trong docs/) — repo này PUBLIC nên không đẩy lên.
# Riêng docs/output.txt là ghi chú kỹ thuật, vẫn theo dõi bình thường.
docs/*.docx
docs/*.xlsx
# docs/bien_ban_giam_dinh.pdf là MẪU GIẤY có dữ liệu khách hàng thật (tên, BKS, SĐT)
docs/*.pdf

# Bộ kiểm thử: thư viện tải về (npm i dựng lại) và file kết quả.
# tests/.out chứa PDF dẫn xuất từ docs/ nên TUYỆT ĐỐI không đẩy lên repo public.
# package-lock.json THÌ GIỮ: nó ghim pdfjs-dist đúng bản PDFJS_VER mà app nạp từ CDN.
tests/node_modules/
tests/.out/
