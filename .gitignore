# Biến môi trường (chứa API key)
.env

# Ảnh tạm và PDF kết xuất
output/
renamed/

# Ảnh hồ sơ khách hàng (số khung, tem đăng kiểm, báo giá...) — KHÔNG đẩy lên GitHub
input/

# Python cache
__pycache__/
*.pyc
*.pyo

# Editor
.vscode/
*.swp

# Windows
Thumbs.db
desktop.ini

# Tài liệu nội bộ của Phòng (.docx/.xlsx trong docs/) — repo này PUBLIC nên không đẩy lên.
# Riêng docs/output.txt là ghi chú kỹ thuật, vẫn theo dõi bình thường.
docs/*.docx
docs/*.xlsx
# docs/bien_ban_giam_dinh.pdf là MẪU GIẤY có dữ liệu khách hàng thật (tên, BKS, SĐT)
docs/*.pdf
